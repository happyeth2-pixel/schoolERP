APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Off-server backups (see DISASTER_RECOVERY.md). Only set on the Render Cron
# Job that runs `backup:run`/`backup:verify`, not on the web service -- the
# web app itself never needs these. RCLONE_CONFIG_* vars configure the actual
# destination and are provider-specific (an example is in DISASTER_RECOVERY.md).
# BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_RCLONE_REMOTE=schoolerp-backups
# BACKUP_RCLONE_PATH=schoolerp
# BACKUP_RETENTION_DAILY_DAYS=14
# BACKUP_RETENTION_WEEKLY_DAYS=60
# BACKUP_RETENTION_MONTHLY_DAYS=400
# MONITORING_HEARTBEAT_BACKUP_RUN_URL=
# MONITORING_HEARTBEAT_BACKUP_VERIFY_URL=
# MONITORING_HEARTBEAT_FAIL_SUFFIX=/fail

# Error monitoring (see MONITORING.md). Hard-disabled on local/testing regardless of what's set
# here (config/sentry.php) -- a copied-and-forgotten DSN on a dev machine must never make dev
# noise land in the production Sentry project. SENTRY_LARAVEL_DSN is the backend (PHP) project;
# SENTRY_JS_DSN is a SEPARATE frontend (JavaScript) Sentry project.
# SENTRY_LARAVEL_DSN=
# SENTRY_JS_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
